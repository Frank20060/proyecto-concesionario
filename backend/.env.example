# Django — Render (producción)
# Copia a las Environment Variables del servicio en Render.

DJANGO_SECRET_KEY=genera-un-secreto-largo-y-aleatorio
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=concesionario-api.onrender.com

# Render inyecta DATABASE_URL automáticamente si vinculas la BD Postgres.

# URL pública del frontend en Vercel (sin barra final)
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-proyecto.vercel.app,https://concesionario-api.onrender.com

# URL pública del propio backend (para URLs de imágenes en la API)
PUBLIC_BASE_URL=https://concesionario-api.onrender.com

# Opcional: disco persistente montado en /app/media (render.yaml)
# MEDIA_ROOT=/app/media
