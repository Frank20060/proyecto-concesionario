# Next.js — Vercel (producción)
# Configura estas variables en Vercel → Project → Settings → Environment Variables.

# URL pública del sitio en Vercel (sin barra final)
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# URL pública del backend Django en Render (sin barra final)
NEXT_PUBLIC_API_URL=https://concesionario-api.onrender.com

# En Vercel usa la misma URL que NEXT_PUBLIC_API_URL (no hay red Docker interna)
API_INTERNAL_URL=https://concesionario-api.onrender.com

# Contacto (opcional)
NEXT_PUBLIC_PHONE=+34900000000
NEXT_PUBLIC_WHATSAPP=34900000000
NEXT_PUBLIC_EMAIL=info@grandmotors.es
